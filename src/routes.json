{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "fhir2": ">=1.2",
    "webservices.rest": ">=2.2.0",
    "reportingrest": "^1.0.0 || ^2.0.0",
    "reporting": ">=1.27.0"
  },
  "pages": [
    {
      "component": "cohortBuilder",
      "route": "cohort-builder",
      "online": true,
      "offline": true
    }
  ],
  "extensions": [
    {
      "name": "system-administration-cohort-builder-card-link",
      "slot": "system-admin-page-card-link-slot",
      "component": "cohortBuilderAdminPageCardLink",
      "online": true,
      "offline": true
    },
    {
      "name": "omnibar-cohort-count-provider",
      "slot": "omnibar-providers-slot",
      "component": "cohortCountOmnibarProvider",
      "privileges": [
        "Get Patients",
        "Run Reports"
      ],
      "meta": {
        "lane": "navigate",
        "scopes": [
          "global"
        ],
        "order": 20,
        "contract": 1,
        "command": {
          "id": "cohort",
          "aliases": [
            "cohort",
            "count"
          ]
        }
      }
    },
    {
      "name": "omnibar-cohort-builder-provider",
      "slot": "omnibar-providers-slot",
      "component": "cohortBuilderOmnibarProvider",
      "privileges": [
        "Get Patients",
        "Run Reports"
      ],
      "meta": {
        "lane": "navigate",
        "scopes": [
          "global"
        ],
        "order": 30,
        "contract": 1
      }
    },
    {
      "name": "omnibar-saved-cohorts-provider",
      "slot": "omnibar-providers-slot",
      "component": "savedCohortsOmnibarProvider",
      "privileges": [
        "Get Patient Cohorts",
        "Get Patients"
      ],
      "meta": {
        "lane": "navigate",
        "scopes": [
          "global"
        ],
        "order": 40,
        "contract": 1
      }
    },
    {
      "name": "omnibar-saved-queries-provider",
      "slot": "omnibar-providers-slot",
      "component": "savedQueriesOmnibarProvider",
      "privileges": [
        "View Reports",
        "Run Reports",
        "Get Patients"
      ],
      "meta": {
        "lane": "navigate",
        "scopes": [
          "global"
        ],
        "order": 50,
        "contract": 1
      }
    }
  ],
  "modals": [
    {
      "name": "clear-search-history-modal",
      "component": "clearSearchHistoryModal"
    },
    {
      "name": "clear-item-from-search-history-modal",
      "component": "clearItemFromSearchHistoryModal"
    },
    {
      "name": "delete-cohort-modal",
      "component": "deleteCohortModal"
    },
    {
      "name": "delete-query-modal",
      "component": "deleteQueryModal"
    },
    {
      "name": "save-cohort-modal",
      "component": "saveCohortModal"
    },
    {
      "name": "save-query-modal",
      "component": "saveQueryModal"
    }
  ]
}
